rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'gecolakey@gmail.com' && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    
    // Booking Validation
    function isValidBooking(data) {
      return data.keys().hasAll(['childName', 'childAge', 'room', 'slot', 'date', 'createdAt', 'ownerUid'])
        && (data.keys().size() == 7 || (data.keys().size() == 8 && data.keys().hasAll(['notes'])))
        && data.childName is string && data.childName.size() >= 1 && data.childName.size() <= 50
        && data.childAge is number && data.childAge >= 0 && data.childAge <= 18
        && (data.get('notes', '') is string && data.get('notes', '').size() <= 1000)
        && data.room in ["SALA FATA TURCHINA", "SALA FOLLETTO ZURLI", "SALA MAGO MERLINO"]
        && data.slot in ["MATTINA", "POMERIGGIO", "SERA"]
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.createdAt == request.time
        && (request.auth == null || data.ownerUid == request.auth.uid);
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if true; // Public can see bookings to check availability
      allow create: if isValidBooking(incoming());
      allow update, delete: if isAdmin();
      
      // Contact Info Sub-collection (PII Isolation)
      match /contacts/info {
        allow read: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/bookings/$(bookingId)).data.ownerUid == request.auth.uid);
        allow create: if incoming().parentPhone is string 
          && incoming().parentPhone.size() >= 5 
          && incoming().parentPhone.size() <= 20
          && incoming().parentPhone.matches('^[0-9+() \\-]+$');
        allow update, delete: if isAdmin();
      }
    }
  }
}
