rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if true; 
      allow create: if request.resource.data.childName is string;
      allow update: if true;
      allow delete: if true;
      
      // Contact Info Sub-collection (PII)
      match /contacts/info {
        allow read: if true;
        allow create, update, delete: if true;
      }
    }

    // System Settings (e.g., custom admin password or config)
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
