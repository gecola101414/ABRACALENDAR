{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "Una prenotazione per una sala compleanno con note interne",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "childName": { "type": "string", "minLength": 2, "maxLength": 50 },
        "childAge": { "type": "number", "minimum": 0, "maximum": 18 },
        "parentPhone": { "type": "string", "pattern": "^[0-9+ ]{8,15}$" },
        "room": { "type": "string", "enum": ["SALA FATA TURCHINA", "SALA FOLLETTO ZURLI", "SALA MAGO MERLINO"] },
        "slot": { "type": "string", "enum": ["MATTINA", "POMERIGGIO", "SERA"] },
        "date": { "type": "string", "format": "date" },
        "notes": { "type": "string", "maxLength": 500 },
        "abracadabraNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["childName", "childAge", "parentPhone", "room", "slot", "date", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Messaggio di chat interna stile WhatsApp tra cliente e staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string", "enum": ["admin", "parent"] },
        "senderName": { "type": "string", "maxLength": 50 },
        "text": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sender", "senderName", "text", "createdAt"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collezione globale delle prenotazioni"
    },
    "/bookings/{bookingId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Subcollezione messaggi WhatsApp di compleanno"
    }
  }
}
