{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "Una prenotazione per una sala compleanno",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "childName": { "type": "string", "minLength": 2, "maxLength": 50 },
        "childAge": { "type": "number", "minimum": 0, "maximum": 18 },
        "parentPhone": { "type": "string", "pattern": "^[0-9+ ]{8,15}$" },
        "room": { "type": "string", "enum": ["SALA FATA TURCHINA", "SALA FOLLETTO ZURLI", "SALA MAGO MERLINO"] },
        "slot": { "type": "string", "enum": ["MATTINA", "POMERIGGIO", "SERA"] },
        "date": { "type": "string", "format": "date" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["childName", "childAge", "parentPhone", "room", "slot", "date", "createdAt"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collezione globale delle prenotazioni"
    }
  }
}
